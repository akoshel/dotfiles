#!/usr/bin/env bash
#
# Re-export the live Firefox profile back into this repo.
# Run this after changing settings in Firefox that you want to keep.
#
# Usage: bash firefox/export
#

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_profile() {
    local root="$HOME/Library/Application Support/Firefox"
    local ini="$root/profiles.ini"
    [ -f "$ini" ] || { echo "No Firefox profiles.ini found" >&2; exit 1; }

    # The [Install…] section records the profile Firefox actually launches,
    # which is not always the one flagged Default=1 under [Profile…].
    local rel
    rel="$(awk -F= '/^\[Install/{ok=1} ok && /^Default=/{print $2; exit}' "$ini")"
    [ -n "$rel" ] || rel="$(awk -F= '/^Default=Profiles/{print $2; exit}' "$ini")"
    echo "$root/$rel"
}

PROFILE="$(find_profile)"
echo "Profile: $PROFILE"

# Preferences worth carrying over. prefs.js holds ~300 entries, almost all of
# them Firefox's own bookkeeping (timestamps, telemetry IDs, migration flags),
# so only the UI-arrangement ones are re-extracted mechanically.
{
    sed -n '1,/^$/p' "$HERE/prefs-seed.js"
    grep -E '^user_pref\("browser\.uiCustomization\.(state|navBarWhenVerticalTabs|horizontalTabstrip)"' "$PROFILE/prefs.js"
    grep -E '^user_pref\("browser\.bookmarks\.defaultLocation"' "$HERE/prefs-seed.js" || true
} > "$HERE/prefs-seed.js.new"
mv "$HERE/prefs-seed.js.new" "$HERE/prefs-seed.js"
echo "  prefs-seed.js  updated"

python3 - "$PROFILE" "$HERE" <<'PY'
import json, sys, pathlib

profile, here = (pathlib.Path(p) for p in sys.argv[1:3])


def dump(obj, name):
    path = here / name
    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False, sort_keys=True) + "\n")
    print(f"  {name:16} updated")


containers = json.loads((profile / "containers.json").read_text())
containers["identities"] = [i for i in containers["identities"] if i.get("public")]
containers["lastUserContextId"] = max(i["userContextId"] for i in containers["identities"])
dump(containers, "containers.json")

handlers = json.loads((profile / "handlers.json").read_text())
dump({k: handlers[k] for k in ("defaultHandlersVersion", "mimeTypes", "schemes") if k in handlers},
     "handlers.json")

# Extension GUIDs actually installed into the profile, minus the ones the
# installer deliberately skips (see extensions.txt).
SKIP = {"newtab@mozilla.org", "{eddf1c58-948d-4e0e-9c42-e611e9050a97}"}
addons = json.loads((profile / "extensions.json").read_text())["addons"]
live = sorted(
    a["id"] for a in addons
    if a.get("type") == "extension" and a.get("location") == "app-profile" and a["id"] not in SKIP
)

manifest = here / "extensions.txt"
header = [l for l in manifest.read_text().splitlines() if l.startswith("#") or not l.strip()]
manifest.write_text("\n".join(header + live) + "\n")
print(f"  extensions.txt   updated ({len(live)} add-ons)")
PY

# Bookmarks: Firefox writes a compressed backup daily; take the newest and
# store it decoded so diffs are readable.
NEWEST="$(ls -t "$PROFILE/bookmarkbackups"/*.jsonlz4 2>/dev/null | head -1 || true)"
if [ -n "$NEWEST" ]; then
    python3 "$HERE/mozlz4.py" decode "$NEWEST" "$HERE/bookmarks.raw.json"
    python3 - "$HERE" <<'PY'
import json, pathlib, sys

here = pathlib.Path(sys.argv[1])
data = json.loads((here / "bookmarks.raw.json").read_text())

NOISE = {"id", "lastModified", "dateAdded", "iconUri", "syncId"}


def clean(node):
    for key in NOISE:
        node.pop(key, None)
    uri = node.get("uri", "")
    if "login.microsoftonline.com" in uri and "?" in uri:
        node["uri"] = uri.split("?", 1)[0]  # expired one-time OIDC state
    for child in node.get("children", []):
        clean(child)


clean(data)
(here / "bookmarks.json").write_text(
    json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
)
(here / "bookmarks.raw.json").unlink()
print("  bookmarks.json   updated")
PY
else
    echo "  bookmarks.json   skipped (no backup in profile yet)"
fi

echo ""
echo "Done. Review with 'git diff' before committing."
