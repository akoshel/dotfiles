# ~/.zprofile — только login-шеллы, читается ПОСЛЕ /etc/zprofile.
#
# /etc/zprofile зовёт path_helper, который перестраивает PATH: системные
# пути в начало, всё остальное в хвост. Поэтому Homebrew приходится
# переприоритезировать здесь — иначе /usr/bin перекроет /opt/homebrew/bin.

[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

export PATH="$HOME/.local/bin:$PATH"
